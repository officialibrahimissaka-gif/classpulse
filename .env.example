# Copy via scripts/local-env.ts for local development; never use example keys.
APP_URL=http://127.0.0.1:3000
APP_ENV=development
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:56379
SESSION_KEY=
DATA_KEY=
AUTH_MODE=oidc
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
COGNITO_USER_POOL_ID=
AWS_REGION=me-central-1
STORAGE_DRIVER=local
ARTIFACT_DIRECTORY=.data/artifacts
MAIL_DRIVER=smtp
SMTP_URL=smtp://127.0.0.1:11025
MAIL_FROM=ClassPulse <no-reply@example.invalid>
# Production: AUTH_MODE=oidc, approved Cognito MFA, STORAGE_DRIVER=s3,
# S3_BUCKET, MAIL_DRIVER=ses and workload IAM; HTTPS APP_URL required.
