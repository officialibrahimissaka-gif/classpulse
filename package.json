{
  "name": "classpulse",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "worker": "tsx src/worker.ts",
    "format": "prettier --write src tests scripts *.json *.ts *.mjs .github",
    "format:check": "prettier --check src tests scripts *.json *.ts *.mjs .github",
    "lint": "eslint src tests scripts",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:generate": "prisma generate",
    "check:migrations": "tsx scripts/check-migrations.ts && tsx scripts/validate-migrations.ts",
    "check:security": "tsx scripts/security-check.ts && npm audit --omit=dev --audit-level=high",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run test:e2e && npm run check:api && npm run check:migrations && npm run check:security && npm run build",
    "check:api": "tsx scripts/api-contract.ts --check && node --input-type=module -e \"import Parser from '@apidevtools/swagger-parser'; await Parser.validate('api/r1.openapi.yaml'); console.log('R1 API contract valid')\"",
    "test:performance": "tsx scripts/phase6-performance.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1161.0",
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/client-sesv2": "3.1161.0",
    "@js-temporal/polyfill": "0.5.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "6.5.3",
    "csv-parse": "7.0.3",
    "csv-stringify": "6.9.0",
    "dotenv": "18.0.9",
    "fflate": "0.8.3",
    "ioredis": "6.0.0",
    "jose": "6.2.14",
    "lucide-react": "1.66.0",
    "next": "16.4.3",
    "nodemailer": "10.3.1",
    "openid-client": "6.8.8",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.4.3",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "read-excel-file": "9.3.14",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "type": "module"
}
