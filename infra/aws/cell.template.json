{
 "AWSTemplateFormatVersion": "2010-09-09",
 "Description": "ClassPulse regional gated launch baseline. Requires reviewed network, secrets, runtime DB roles and release evidence. NOT applied.",
 "Parameters": {
  "Environment": {
   "Type": "String",
   "AllowedValues": [
    "staging",
    "production"
   ]
  },
  "VpcId": {
   "Type": "AWS::EC2::VPC::Id"
  },
  "PublicSubnets": {
   "Type": "List<AWS::EC2::Subnet::Id>"
  },
  "PrivateSubnets": {
   "Type": "List<AWS::EC2::Subnet::Id>"
  },
  "HostedZoneId": {
   "Type": "AWS::Route53::HostedZone::Id"
  },
  "DomainName": {
   "Type": "String",
   "AllowedPattern": "[a-z0-9.-]+"
  },
  "MailDomain": {
   "Type": "String",
   "AllowedPattern": "[a-z0-9.-]+"
  },
  "OidcDomainPrefix": {
   "Type": "String",
   "AllowedPattern": "[a-z0-9-]+"
  },
  "WebImage": {
   "Type": "String",
   "AllowedPattern": "[0-9]{12}\\.dkr\\.ecr\\.me-central-1\\.amazonaws\\.com/[a-z0-9/_-]+@sha256:[a-f0-9]{64}"
  },
  "WorkerImage": {
   "Type": "String",
   "AllowedPattern": "[0-9]{12}\\.dkr\\.ecr\\.me-central-1\\.amazonaws\\.com/[a-z0-9/_-]+@sha256:[a-f0-9]{64}"
  },
  "OperationsImage": {
   "Type": "String",
   "AllowedPattern": "[0-9]{12}\\.dkr\\.ecr\\.me-central-1\\.amazonaws\\.com/[a-z0-9/_-]+@sha256:[a-f0-9]{64}"
  },
  "RuntimeSecretArn": {
   "Type": "String",
   "AllowedPattern": "arn:aws:secretsmanager:me-central-1:[0-9]{12}:secret:.+"
  },
  "DispatcherSecretArn": {
   "Type": "String",
   "AllowedPattern": "arn:aws:secretsmanager:me-central-1:[0-9]{12}:secret:.+"
  },
  "MigrationSecretArn": {
   "Type": "String",
   "AllowedPattern": "arn:aws:secretsmanager:me-central-1:[0-9]{12}:secret:.+"
  },
  "ReleaseTraffic": {
   "Type": "String",
   "AllowedValues": [
    "false",
    "true"
   ],
   "Default": "false"
  },
  "AlertEmail": {
   "Type": "String",
   "AllowedPattern": "[^@ ]+@[^@ ]+\\.[^@ ]+"
  },
  "DatabaseClass": {
   "Type": "String",
   "Default": "db.t4g.medium"
  },
  "PostgresEngineVersion": {
   "Type": "String",
   "AllowedPattern": "17\\.[0-9]+",
   "Description": "Explicit supported PostgreSQL 17 patch verified in me-central-1 before apply; no guessed default."
  }
 },
 "Conditions": {
  "TrafficEnabled": {
   "Fn::Equals": [
    {
     "Ref": "ReleaseTraffic"
    },
    "true"
   ]
  }
 },
 "Resources": {
  "Key": {
   "Type": "AWS::KMS::Key",
   "Properties": {
    "EnableKeyRotation": true,
    "KeyPolicy": {
     "Version": "2012-10-17",
     "Statement": [
      {
       "Effect": "Allow",
       "Principal": {
        "AWS": {
         "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:root"
        }
       },
       "Action": "kms:*",
       "Resource": "*"
      }
     ]
    }
   },
   "DeletionPolicy": "Retain",
   "UpdateReplacePolicy": "Retain"
  },
  "Artifacts": {
   "Type": "AWS::S3::Bucket",
   "Properties": {
    "BucketEncryption": {
     "ServerSideEncryptionConfiguration": [
      {
       "ServerSideEncryptionByDefault": {
        "SSEAlgorithm": "aws:kms",
        "KMSMasterKeyID": {
         "Fn::GetAtt": [
          "Key",
          "Arn"
         ]
        }
       },
       "BucketKeyEnabled": true
      }
     ]
    },
    "VersioningConfiguration": {
     "Status": "Enabled"
    },
    "PublicAccessBlockConfiguration": {
     "BlockPublicAcls": true,
     "BlockPublicPolicy": true,
     "IgnorePublicAcls": true,
     "RestrictPublicBuckets": true
    },
    "OwnershipControls": {
     "Rules": [
      {
       "ObjectOwnership": "BucketOwnerEnforced"
      }
     ]
    }
   },
   "DeletionPolicy": "Retain",
   "UpdateReplacePolicy": "Retain"
  },
  "ArtifactPolicy": {
   "Type": "AWS::S3::BucketPolicy",
   "Properties": {
    "Bucket": {
     "Ref": "Artifacts"
    },
    "PolicyDocument": {
     "Version": "2012-10-17",
     "Statement": [
      {
       "Effect": "Deny",
       "Principal": "*",
       "Action": "s3:*",
       "Resource": [
        {
         "Fn::GetAtt": [
          "Artifacts",
          "Arn"
         ]
        },
        {
         "Fn::Sub": "${Artifacts.Arn}/*"
        }
       ],
       "Condition": {
        "Bool": {
         "aws:SecureTransport": "false"
        }
       }
      }
     ]
    }
   }
  },
  "Alerts": {
   "Type": "AWS::SNS::Topic",
   "Properties": {
    "Subscription": [
     {
      "Protocol": "email",
      "Endpoint": {
       "Ref": "AlertEmail"
      }
     }
    ]
   }
  },
  "WebLogs": {
   "Type": "AWS::Logs::LogGroup",
   "Properties": {
    "RetentionInDays": 30
   },
   "DeletionPolicy": "Retain",
   "UpdateReplacePolicy": "Retain"
  },
  "WorkerLogs": {
   "Type": "AWS::Logs::LogGroup",
   "Properties": {
    "RetentionInDays": 30
   },
   "DeletionPolicy": "Retain",
   "UpdateReplacePolicy": "Retain"
  },
  "OperationsLogs": {
   "Type": "AWS::Logs::LogGroup",
   "Properties": {
    "RetentionInDays": 30
   },
   "DeletionPolicy": "Retain",
   "UpdateReplacePolicy": "Retain"
  },
  "IngressSG": {
   "Type": "AWS::EC2::SecurityGroup",
   "Properties": {
    "GroupDescription": "Ingress isolated ClassPulse",
    "VpcId": {
     "Ref": "VpcId"
    },
    "SecurityGroupEgress": [
     {
      "IpProtocol": "-1",
      "CidrIp": "0.0.0.0/0"
     }
    ]
   }
  },
  "ApplicationSG": {
   "Type": "AWS::EC2::SecurityGroup",
   "Properties": {
    "GroupDescription": "Application isolated ClassPulse",
    "VpcId": {
     "Ref": "VpcId"
    },
    "SecurityGroupEgress": [
     {
      "IpProtocol": "-1",
      "CidrIp": "0.0.0.0/0"
     }
    ]
   }
  },
  "DatabaseSG": {
   "Type": "AWS::EC2::SecurityGroup",
   "Properties": {
    "GroupDescription": "Database isolated ClassPulse",
    "VpcId": {
     "Ref": "VpcId"
    },
    "SecurityGroupEgress": [
     {
      "IpProtocol": "-1",
      "CidrIp": "0.0.0.0/0"
     }
    ]
   }
  },
  "RedisSG": {
   "Type": "AWS::EC2::SecurityGroup",
   "Properties": {
    "GroupDescription": "Redis isolated ClassPulse",
    "VpcId": {
     "Ref": "VpcId"
    },
    "SecurityGroupEgress": [
     {
      "IpProtocol": "-1",
      "CidrIp": "0.0.0.0/0"
     }
    ]
   }
  },
  "OperationsSG": {
   "Type": "AWS::EC2::SecurityGroup",
   "Properties": {
    "GroupDescription": "Operations isolated ClassPulse",
    "VpcId": {
     "Ref": "VpcId"
    },
    "SecurityGroupEgress": [
     {
      "IpProtocol": "-1",
      "CidrIp": "0.0.0.0/0"
     }
    ]
   }
  },
  "PublicHttps": {
   "Type": "AWS::EC2::SecurityGroupIngress",
   "Properties": {
    "GroupId": {
     "Ref": "IngressSG"
    },
    "IpProtocol": "tcp",
    "FromPort": 443,
    "ToPort": 443,
    "CidrIp": "0.0.0.0/0"
   }
  },
  "AppIngress": {
   "Type": "AWS::EC2::SecurityGroupIngress",
   "Properties": {
    "GroupId": {
     "Ref": "ApplicationSG"
    },
    "IpProtocol": "tcp",
    "FromPort": 3000,
    "ToPort": 3000,
    "SourceSecurityGroupId": {
     "Ref": "IngressSG"
    }
   }
  },
  "DatabaseApplicationIngress": {
   "Type": "AWS::EC2::SecurityGroupIngress",
   "Properties": {
    "GroupId": {
     "Ref": "DatabaseSG"
    },
    "IpProtocol": "tcp",
    "FromPort": 5432,
    "ToPort": 5432,
    "SourceSecurityGroupId": {
     "Ref": "ApplicationSG"
    }
   }
  },
  "DatabaseOperationsIngress": {
   "Type": "AWS::EC2::SecurityGroupIngress",
   "Properties": {
    "GroupId": {
     "Ref": "DatabaseSG"
    },
    "IpProtocol": "tcp",
    "FromPort": 5432,
    "ToPort": 5432,
    "SourceSecurityGroupId": {
     "Ref": "OperationsSG"
    }
   }
  },
  "RedisApplicationIngress": {
   "Type": "AWS::EC2::SecurityGroupIngress",
   "Properties": {
    "GroupId": {
     "Ref": "RedisSG"
    },
    "IpProtocol": "tcp",
    "FromPort": 6379,
    "ToPort": 6379,
    "SourceSecurityGroupId": {
     "Ref": "ApplicationSG"
    }
   }
  },
  "RedisOperationsIngress": {
   "Type": "AWS::EC2::SecurityGroupIngress",
   "Properties": {
    "GroupId": {
     "Ref": "RedisSG"
    },
    "IpProtocol": "tcp",
    "FromPort": 6379,
    "ToPort": 6379,
    "SourceSecurityGroupId": {
     "Ref": "OperationsSG"
    }
   }
  },
  "DBSubnets": {
   "Type": "AWS::RDS::DBSubnetGroup",
   "Properties": {
    "DBSubnetGroupDescription": "Private database subnets",
    "SubnetIds": {
     "Ref": "PrivateSubnets"
    }
   }
  },
  "DatabaseParameters": {
   "Type": "AWS::RDS::DBParameterGroup",
   "Properties": {
    "Description": "Require TLS",
    "Family": "postgres17",
    "Parameters": {
     "rds.force_ssl": "1"
    }
   }
  },
  "Database": {
   "Type": "AWS::RDS::DBInstance",
   "Properties": {
    "Engine": "postgres",
    "EngineVersion": {
     "Ref": "PostgresEngineVersion"
    },
    "DBInstanceClass": {
     "Ref": "DatabaseClass"
    },
    "AllocatedStorage": "50",
    "MaxAllocatedStorage": 200,
    "StorageType": "gp3",
    "StorageEncrypted": true,
    "KmsKeyId": {
     "Fn::GetAtt": [
      "Key",
      "Arn"
     ]
    },
    "DBName": "classpulse",
    "MasterUsername": "classpulse_owner",
    "ManageMasterUserPassword": true,
    "MasterUserSecret": {
     "KmsKeyId": {
      "Fn::GetAtt": [
       "Key",
       "Arn"
      ]
     }
    },
    "DBSubnetGroupName": {
     "Ref": "DBSubnets"
    },
    "DBParameterGroupName": {
     "Ref": "DatabaseParameters"
    },
    "VPCSecurityGroups": [
     {
      "Ref": "DatabaseSG"
     }
    ],
    "MultiAZ": true,
    "PubliclyAccessible": false,
    "BackupRetentionPeriod": 35,
    "DeletionProtection": true,
    "AutoMinorVersionUpgrade": true,
    "CopyTagsToSnapshot": true,
    "EnableCloudwatchLogsExports": [
     "postgresql",
     "upgrade"
    ]
   },
   "DeletionPolicy": "Snapshot",
   "UpdateReplacePolicy": "Snapshot"
  },
  "RedisSecret": {
   "Type": "AWS::SecretsManager::Secret",
   "Properties": {
    "KmsKeyId": {
     "Fn::GetAtt": [
      "Key",
      "Arn"
     ]
    },
    "GenerateSecretString": {
     "PasswordLength": 40,
     "ExcludePunctuation": true
    }
   }
  },
  "RedisSubnets": {
   "Type": "AWS::ElastiCache::SubnetGroup",
   "Properties": {
    "Description": "Private Redis subnets",
    "SubnetIds": {
     "Ref": "PrivateSubnets"
    }
   }
  },
  "RedisParameters": {
   "Type": "AWS::ElastiCache::ParameterGroup",
   "Properties": {
    "Description": "Durable queue noeviction",
    "CacheParameterGroupFamily": "redis7",
    "Properties": {
     "maxmemory-policy": "noeviction"
    }
   }
  },
  "Redis": {
   "Type": "AWS::ElastiCache::ReplicationGroup",
   "Properties": {
    "ReplicationGroupDescription": "ClassPulse queues",
    "Engine": "redis",
    "EngineVersion": "7.1",
    "CacheNodeType": "cache.t4g.small",
    "NumCacheClusters": 2,
    "AutomaticFailoverEnabled": true,
    "MultiAZEnabled": true,
    "AtRestEncryptionEnabled": true,
    "KmsKeyId": {
     "Fn::GetAtt": [
      "Key",
      "Arn"
     ]
    },
    "TransitEncryptionEnabled": true,
    "AuthToken": {
     "Fn::Sub": "{{resolve:secretsmanager:${RedisSecret}:SecretString}}"
    },
    "SecurityGroupIds": [
     {
      "Ref": "RedisSG"
     }
    ],
    "CacheSubnetGroupName": {
     "Ref": "RedisSubnets"
    },
    "CacheParameterGroupName": {
     "Ref": "RedisParameters"
    },
    "SnapshotRetentionLimit": 7,
    "AutoMinorVersionUpgrade": true
   },
   "DeletionPolicy": "Retain",
   "UpdateReplacePolicy": "Retain"
  },
  "UserPool": {
   "Type": "AWS::Cognito::UserPool",
   "Properties": {
    "UserPoolName": {
     "Fn::Sub": "${AWS::StackName}-identity"
    },
    "UsernameAttributes": [
     "email"
    ],
    "AutoVerifiedAttributes": [
     "email"
    ],
    "MfaConfiguration": "ON",
    "EnabledMfas": [
     "SOFTWARE_TOKEN_MFA"
    ],
    "UserPoolAddOns": {
     "AdvancedSecurityMode": "ENFORCED"
    },
    "Policies": {
     "PasswordPolicy": {
      "MinimumLength": 14,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireNumbers": true,
      "RequireSymbols": true
     }
    },
    "DeletionProtection": "ACTIVE"
   },
   "DeletionPolicy": "Retain",
   "UpdateReplacePolicy": "Retain"
  },
  "UserPoolClient": {
   "Type": "AWS::Cognito::UserPoolClient",
   "Properties": {
    "UserPoolId": {
     "Ref": "UserPool"
    },
    "GenerateSecret": false,
    "AllowedOAuthFlowsUserPoolClient": true,
    "AllowedOAuthFlows": [
     "code"
    ],
    "AllowedOAuthScopes": [
     "openid",
     "email",
     "profile"
    ],
    "SupportedIdentityProviders": [
     "COGNITO"
    ],
    "CallbackURLs": [
     {
      "Fn::Sub": "https://${DomainName}/api/auth/callback"
     }
    ],
    "LogoutURLs": [
     {
      "Fn::Sub": "https://${DomainName}/"
     }
    ],
    "PreventUserExistenceErrors": "ENABLED",
    "EnableTokenRevocation": true,
    "ExplicitAuthFlows": [
     "ALLOW_REFRESH_TOKEN_AUTH"
    ]
   }
  },
  "UserPoolDomain": {
   "Type": "AWS::Cognito::UserPoolDomain",
   "Properties": {
    "Domain": {
     "Ref": "OidcDomainPrefix"
    },
    "UserPoolId": {
     "Ref": "UserPool"
    }
   }
  },
  "MailIdentity": {
   "Type": "AWS::SES::EmailIdentity",
   "Properties": {
    "EmailIdentity": {
     "Ref": "MailDomain"
    },
    "DkimSigningAttributes": {
     "NextSigningKeyLength": "RSA_2048_BIT"
    }
   }
  },
  "Certificate": {
   "Type": "AWS::CertificateManager::Certificate",
   "Properties": {
    "DomainName": {
     "Ref": "DomainName"
    },
    "ValidationMethod": "DNS",
    "DomainValidationOptions": [
     {
      "DomainName": {
       "Ref": "DomainName"
      },
      "HostedZoneId": {
       "Ref": "HostedZoneId"
      }
     }
    ]
   }
  },
  "LoadBalancer": {
   "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
   "Properties": {
    "Scheme": "internet-facing",
    "Type": "application",
    "Subnets": {
     "Ref": "PublicSubnets"
    },
    "SecurityGroups": [
     {
      "Ref": "IngressSG"
     }
    ],
    "LoadBalancerAttributes": [
     {
      "Key": "deletion_protection.enabled",
      "Value": "true"
     },
     {
      "Key": "routing.http.drop_invalid_header_fields.enabled",
      "Value": "true"
     }
    ]
   }
  },
  "Target": {
   "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
   "Properties": {
    "VpcId": {
     "Ref": "VpcId"
    },
    "Protocol": "HTTP",
    "Port": 3000,
    "TargetType": "ip",
    "HealthCheckPath": "/api/health",
    "HealthCheckIntervalSeconds": 30,
    "HealthyThresholdCount": 2,
    "UnhealthyThresholdCount": 3,
    "TargetGroupAttributes": [
     {
      "Key": "deregistration_delay.timeout_seconds",
      "Value": "30"
     }
    ]
   }
  },
  "Listener": {
   "Type": "AWS::ElasticLoadBalancingV2::Listener",
   "Properties": {
    "LoadBalancerArn": {
     "Ref": "LoadBalancer"
    },
    "Port": 443,
    "Protocol": "HTTPS",
    "SslPolicy": "ELBSecurityPolicy-TLS13-1-2-2021-06",
    "Certificates": [
     {
      "CertificateArn": {
       "Ref": "Certificate"
      }
     }
    ],
    "DefaultActions": [
     {
      "Type": "forward",
      "TargetGroupArn": {
       "Ref": "Target"
      }
     }
    ]
   }
  },
  "DNS": {
   "Type": "AWS::Route53::RecordSet",
   "Properties": {
    "HostedZoneId": {
     "Ref": "HostedZoneId"
    },
    "Name": {
     "Ref": "DomainName"
    },
    "Type": "A",
    "AliasTarget": {
     "DNSName": {
      "Fn::GetAtt": [
       "LoadBalancer",
       "DNSName"
      ]
     },
     "HostedZoneId": {
      "Fn::GetAtt": [
       "LoadBalancer",
       "CanonicalHostedZoneID"
      ]
     }
    }
   }
  },
  "WAF": {
   "Type": "AWS::WAFv2::WebACL",
   "Properties": {
    "Scope": "REGIONAL",
    "DefaultAction": {
     "Allow": {}
    },
    "VisibilityConfig": {
     "CloudWatchMetricsEnabled": true,
     "MetricName": "ClassPulseWaf",
     "SampledRequestsEnabled": false
    },
    "Rules": [
     {
      "Name": "Baseline",
      "Priority": 1,
      "OverrideAction": {
       "None": {}
      },
      "Statement": {
       "ManagedRuleGroupStatement": {
        "VendorName": "AWS",
        "Name": "AWSManagedRulesCommonRuleSet"
       }
      },
      "VisibilityConfig": {
       "CloudWatchMetricsEnabled": true,
       "MetricName": "Baseline",
       "SampledRequestsEnabled": false
      }
     }
    ]
   }
  },
  "WAFAssociation": {
   "Type": "AWS::WAFv2::WebACLAssociation",
   "Properties": {
    "ResourceArn": {
     "Ref": "LoadBalancer"
    },
    "WebACLArn": {
     "Fn::GetAtt": [
      "WAF",
      "Arn"
     ]
    }
   }
  },
  "Cluster": {
   "Type": "AWS::ECS::Cluster",
   "Properties": {
    "ClusterSettings": [
     {
      "Name": "containerInsights",
      "Value": "enabled"
     }
    ],
    "Tags": [
     {
      "Key": "Environment",
      "Value": {
       "Ref": "Environment"
      }
     }
    ]
   }
  },
  "WebExecution": {
   "Type": "AWS::IAM::Role",
   "Properties": {
    "AssumeRolePolicyDocument": {
     "Version": "2012-10-17",
     "Statement": [
      {
       "Effect": "Allow",
       "Principal": {
        "Service": "ecs-tasks.amazonaws.com"
       },
       "Action": "sts:AssumeRole"
      }
     ]
    },
    "Policies": [
     {
      "PolicyName": "ScopedWorkload",
      "PolicyDocument": {
       "Version": "2012-10-17",
       "Statement": [
        {
         "Effect": "Allow",
         "Action": [
          "ecr:GetAuthorizationToken"
         ],
         "Resource": "*"
        },
        {
         "Effect": "Allow",
         "Action": [
          "ecr:BatchCheckLayerAvailability",
          "ecr:GetDownloadUrlForLayer",
          "ecr:BatchGetImage"
         ],
         "Resource": {
          "Fn::Sub": "arn:aws:ecr:${AWS::Region}:${AWS::AccountId}:repository/classpulse/*"
         }
        },
        {
         "Effect": "Allow",
         "Action": [
          "logs:CreateLogStream",
          "logs:PutLogEvents"
         ],
         "Resource": [
          {
           "Fn::GetAtt": [
            "WebLogs",
            "Arn"
           ]
          },
          {
           "Fn::GetAtt": [
            "WorkerLogs",
            "Arn"
           ]
          },
          {
           "Fn::GetAtt": [
            "OperationsLogs",
            "Arn"
           ]
          }
         ]
        },
        {
         "Effect": "Allow",
         "Action": [
          "secretsmanager:GetSecretValue"
         ],
         "Resource": [
          {
           "Ref": "RuntimeSecretArn"
          }
         ]
        },
        {
         "Effect": "Allow",
         "Action": [
          "kms:Decrypt"
         ],
         "Resource": {
          "Fn::GetAtt": [
           "Key",
           "Arn"
          ]
         }
        }
       ]
      }
     }
    ]
   }
  },
  "WorkerExecution": {
   "Type": "AWS::IAM::Role",
   "Properties": {
    "AssumeRolePolicyDocument": {
     "Version": "2012-10-17",
     "Statement": [
      {
       "Effect": "Allow",
       "Principal": {
        "Service": "ecs-tasks.amazonaws.com"
       },
       "Action": "sts:AssumeRole"
      }
     ]
    },
    "Policies": [
     {
      "PolicyName": "ScopedWorkload",
      "PolicyDocument": {
       "Version": "2012-10-17",
       "Statement": [
        {
         "Effect": "Allow",
         "Action": [
          "ecr:GetAuthorizationToken"
         ],
         "Resource": "*"
        },
        {
         "Effect": "Allow",
         "Action": [
          "ecr:BatchCheckLayerAvailability",
          "ecr:GetDownloadUrlForLayer",
          "ecr:BatchGetImage"
         ],
         "Resource": {
          "Fn::Sub": "arn:aws:ecr:${AWS::Region}:${AWS::AccountId}:repository/classpulse/*"
         }
        },
        {
         "Effect": "Allow",
         "Action": [
          "logs:CreateLogStream",
          "logs:PutLogEvents"
         ],
         "Resource": [
          {
           "Fn::GetAtt": [
            "WebLogs",
            "Arn"
           ]
          },
          {
           "Fn::GetAtt": [
            "WorkerLogs",
            "Arn"
           ]
          },
          {
           "Fn::GetAtt": [
            "OperationsLogs",
            "Arn"
           ]
          }
         ]
        },
        {
         "Effect": "Allow",
         "Action": [
          "secretsmanager:GetSecretValue"
         ],
         "Resource": [
          {
           "Ref": "RuntimeSecretArn"
          },
          {
