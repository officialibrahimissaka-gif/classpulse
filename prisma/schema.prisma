/// Compliance; S1; Later; effective. 
model RuleVersion {
  id                                      String                    @default(uuid()) @db.Uuid
  tenantId                                String                    @map("tenant_id") @db.Uuid
  version                                 Int                       @default(1)
  createdAt                               DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                               DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt                              DateTime?                 @map("archived_at") @db.Timestamptz(6)
  deletedAt                               DateTime?                 @map("deleted_at") @db.Timestamptz(6)
  semanticVersion                         String                    @map("semantic_version") @db.VarChar(30)
  validFrom                               DateTime                  @map("valid_from") @db.Date
  validTo                                 DateTime?                 @map("valid_to") @db.Date
  recordedAt                              DateTime                  @default(now()) @map("recorded_at") @db.Timestamptz(6)
  sourceUrl                               String                    @map("source_url") @db.VarChar(1000)
  sourceHash                              String                    @map("source_hash") @db.Char(64)
  coverageCode                            String                    @map("coverage_code") @db.VarChar(100)
  state                                   String                    @db.VarChar(30)
  fixtureHash                             String?                   @map("fixture_hash") @db.Char(64)
  packId                                  String                    @map("pack_id") @db.Uuid
  legalReviewerId                         String?                   @map("legal_reviewer_id") @db.Uuid
  engineeringReviewerId                   String?                   @map("engineering_reviewer_id") @db.Uuid
  supersededAt                            DateTime?                 @map("superseded_at") @db.Timestamptz(6)
  tenant                                  Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  pack                                    JurisdictionPack          @relation("RuleVersion_pack", fields: [tenantId, packId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  legalReviewer                           Membership?               @relation("RuleVersion_legalReviewer", fields: [tenantId, legalReviewerId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  engineeringReviewer                     Membership?               @relation("RuleVersion_engineeringReviewer", fields: [tenantId, engineeringReviewerId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  fromApplicabilityAssignment_ruleVersion ApplicabilityAssignment[] @relation("ApplicabilityAssignment_ruleVersion")
  fromLeavePolicyVersion_ruleVersion      LeavePolicyVersion[]      @relation("LeavePolicyVersion_ruleVersion")
  fromPayrollProviderExport_ruleVersion   PayrollProviderExport[]   @relation("PayrollProviderExport_ruleVersion")
  fromPayRun_ruleVersion                  PayRun[]                  @relation("PayRun_ruleVersion")
  fromFinalSettlement_ruleVersion         FinalSettlement[]         @relation("FinalSettlement_ruleVersion")

  @@id([tenantId, id])
  @@unique([tenantId, packId, semanticVersion])
  @@index([tenantId, createdAt, id])
  @@index([tenantId, packId])
  @@index([tenantId, legalReviewerId])
  @@index([tenantId, engineeringReviewerId])
  @@map("rule_version")
}

