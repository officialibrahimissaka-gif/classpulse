/// Tenancy; S2; R1; mutable. 
model LegalEntity {
  id                                 String                    @default(uuid()) @db.Uuid
  tenantId                           String                    @map("tenant_id") @db.Uuid
  version                            Int                       @default(1)
  createdAt                          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt                         DateTime?                 @map("archived_at") @db.Timestamptz(6)
  deletedAt                          DateTime?                 @map("deleted_at") @db.Timestamptz(6)
  code                               String                    @db.VarChar(40)
  name                               String                    @db.VarChar(240)
  countryCode                        String                    @map("country_code") @db.Char(2)
  authorityCode                      String                    @map("authority_code") @db.VarChar(80)
  timeZone                           String                    @map("time_zone") @db.VarChar(80)
  defaultCurrency                    String                    @map("default_currency") @db.Char(3)
  tenant                             Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fromTeam_entity                    Team[]                    @relation("Team_entity")
  fromWorkCalendar_entity            WorkCalendar[]            @relation("WorkCalendar_entity")
  fromApplicabilityAssignment_entity ApplicabilityAssignment[] @relation("ApplicabilityAssignment_entity")
  fromRetentionPolicy_entity         RetentionPolicy[]         @relation("RetentionPolicy_entity")
  fromRoleGrant_entity               RoleGrant[]               @relation("RoleGrant_entity")
  fromClientAccount_entity           ClientAccount[]           @relation("ClientAccount_entity")
  fromPlacement_entity               Placement[]               @relation("Placement_entity")
  fromPosition_entity                Position[]                @relation("Position_entity")
  fromEmployment_entity              Employment[]              @relation("Employment_entity")
  fromRequisition_entity             Requisition[]             @relation("Requisition_entity")
  fromLeavePolicyVersion_entity      LeavePolicyVersion[]      @relation("LeavePolicyVersion_entity")
  fromShift_entity                   Shift[]                   @relation("Shift_entity")
  fromPayPeriod_entity               PayPeriod[]               @relation("PayPeriod_entity")
  fromCompensationCycle_entity       CompensationCycle[]       @relation("CompensationCycle_entity")
  fromBenefitPlan_entity             BenefitPlan[]             @relation("BenefitPlan_entity")
  fromReviewCycle_entity             ReviewCycle[]             @relation("ReviewCycle_entity")
  fromAsset_entity                   Asset[]                   @relation("Asset_entity")
  fromAnnouncement_entity            Announcement[]            @relation("Announcement_entity")
  fromSurvey_entity                  Survey[]                  @relation("Survey_entity")
  fromCommercialContract_entity      CommercialContract[]      @relation("CommercialContract_entity")

  @@id([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, createdAt, id])
  @@map("legal_entity")
}

/// Tenancy; S2; R1; mutable. 
model Team {
  id                              String                   @default(uuid()) @db.Uuid
  tenantId                        String                   @map("tenant_id") @db.Uuid
  version                         Int                      @default(1)
  createdAt                       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt                      DateTime?                @map("archived_at") @db.Timestamptz(6)
  deletedAt                       DateTime?                @map("deleted_at") @db.Timestamptz(6)
  code                            String                   @db.VarChar(60)
  name                            String                   @db.VarChar(160)
  entityId                        String                   @map("entity_id") @db.Uuid
  parentId                        String?                  @map("parent_id") @db.Uuid
  tenant                          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  entity                          LegalEntity              @relation("Team_entity", fields: [tenantId, entityId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  parent                          Team?                    @relation("Team_parent", fields: [tenantId, parentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  fromTeam_parent                 Team[]                   @relation("Team_parent")
  fromRoleGrant_team              RoleGrant[]              @relation("RoleGrant_team")
  fromPosition_team               Position[]               @relation("Position_team")
  fromShift_team                  Shift[]                  @relation("Shift_team")
  fromSavedView_team              SavedView[]              @relation("SavedView_team")
  fromOrganizationAssignment_team OrganizationAssignment[] @relation("OrganizationAssignment_team")

  @@id([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, createdAt, id])
  @@index([tenantId, entityId])
  @@index([tenantId, parentId])
  @@map("team")
}

/// Global configuration; S2; Later; mutable. 
model WorkCalendar {
  id                           String            @default(uuid()) @db.Uuid
  tenantId                     String            @map("tenant_id") @db.Uuid
  version                      Int               @default(1)
  createdAt                    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt                   DateTime?         @map("archived_at") @db.Timestamptz(6)
  deletedAt                    DateTime?         @map("deleted_at") @db.Timestamptz(6)
  name                         String            @db.VarChar(160)
  timeZone                     String            @map("time_zone") @db.VarChar(80)
  entityId                     String            @map("entity_id") @db.Uuid
  tenant                       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  entity                       LegalEntity       @relation("WorkCalendar_entity", fields: [tenantId, entityId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  fromCalendarVersion_calendar CalendarVersion[] @relation("CalendarVersion_calendar")

  @@id([tenantId, id])
  @@unique([tenantId, entityId, name])
  @@index([tenantId, createdAt, id])
  @@index([tenantId, entityId])
  @@map("work_calendar")
}

/// Global configuration; S2; Later; effective. 
model CalendarVersion {
  id                                   String             @default(uuid()) @db.Uuid
  tenantId                             String             @map("tenant_id") @db.Uuid
  version                              Int                @default(1)
  createdAt                            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt                           DateTime?          @map("archived_at") @db.Timestamptz(6)
  deletedAt                            DateTime?          @map("deleted_at") @db.Timestamptz(6)
  validFrom                            DateTime           @map("valid_from") @db.Date
  validTo                              DateTime?          @map("valid_to") @db.Date
  recordedAt                           DateTime           @default(now()) @map("recorded_at") @db.Timestamptz(6)
  weekMask                             Int                @map("week_mask") @db.SmallInt
  sourceReference                      String             @map("source_reference") @db.VarChar(500)
  approvalState                        String             @map("approval_state") @db.VarChar(30)
  calendarId                           String             @map("calendar_id") @db.Uuid
  approvedById                         String?            @map("approved_by_id") @db.Uuid
  supersededAt                         DateTime?          @map("superseded_at") @db.Timestamptz(6)
  tenant                               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  calendar                             WorkCalendar       @relation("CalendarVersion_calendar", fields: [tenantId, calendarId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  approvedBy                           Membership?        @relation("CalendarVersion_approvedBy", fields: [tenantId, approvedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  fromCalendarDay_calendarVersion      CalendarDay[]      @relation("CalendarDay_calendarVersion")
  fromEmploymentTerm_calendarVersion   EmploymentTerm[]   @relation("EmploymentTerm_calendarVersion")
  fromSlaPolicyVersion_calendarVersion SlaPolicyVersion[] @relation("SlaPolicyVersion_calendarVersion")

  @@id([tenantId, id])
  @@index([tenantId, createdAt, id])
  @@index([tenantId, calendarId])
  @@index([tenantId, approvedById])
  @@map("calendar_version")
}

/// Global configuration; S2; Later; mutable. 
model CalendarDay {
  id                String          @default(uuid()) @db.Uuid
  tenantId          String          @map("tenant_id") @db.Uuid
  version           Int             @default(1)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt        DateTime?       @map("archived_at") @db.Timestamptz(6)
  deletedAt         DateTime?       @map("deleted_at") @db.Timestamptz(6)
  localDate         DateTime        @map("local_date") @db.Date
  kind              String          @db.VarChar(30)
  workingMinutes    Int             @map("working_minutes")
  label             String          @db.VarChar(200)
  calendarVersionId String          @map("calendar_version_id") @db.Uuid
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  calendarVersion   CalendarVersion @relation("CalendarDay_calendarVersion", fields: [tenantId, calendarVersionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, id])
  @@unique([tenantId, calendarVersionId, localDate])
  @@index([tenantId, createdAt, id])
  @@index([tenantId, calendarVersionId])
  @@map("calendar_day")
}

/// Compliance; S1; Later; mutable. 
model JurisdictionPack {
