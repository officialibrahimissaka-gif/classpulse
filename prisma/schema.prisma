// Phase 3 design, 1 November 2026. No application implementation.
// PostgreSQL constraints/RLS in constraints.sql are mandatory companions.
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

