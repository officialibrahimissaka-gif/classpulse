generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  billingConnection             BillingConnection?
  billingPayments               BillingPayment[]
  teamMemberships               TeamMembership[]
  r1CommercialChangeRequestRows CommercialChangeRequest[]

  r1InvitationDeliveryRows InvitationDelivery[]

  r1ReportRunRows ReportRun[]

  registrationHash        String? @unique @map("registration_hash") @db.Char(64)
  registrationPayloadHash String? @map("registration_payload_hash") @db.Char(64)
  dataRevision            Int     @default(1) @map("data_revision")

  id                        String                  @id @default(uuid()) @db.Uuid
  slug                      String                  @unique @db.VarChar(80)
  name                      String                  @db.VarChar(240)
  residencyCell             String                  @map("residency_cell") @db.VarChar(80)
  status                    String                  @db.VarChar(30)
  entitlementRevision       Int                     @default(1) @map("entitlement_revision")
  createdAt                 DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  legalEntityRows           LegalEntity[]
  teamRows                  Team[]
  retentionPolicyRows       RetentionPolicy[]
  legalHoldRows             LegalHold[]
  heldRecordRows            HeldRecord[]
  privacyRequestRows        PrivacyRequest[]
  deletionTombstoneRows     DeletionTombstone[]
  principalRows             Principal[]
  membershipRows            Membership[]
  roleRows                  Role[]
  rolePermissionRows        RolePermission[]
  roleGrantRows             RoleGrant[]
  sessionRows               Session[]
  invitationRows            Invitation[]
  clientAccountRows         ClientAccount[]
  contactRows               Contact[]
  candidateRows             Candidate[]
  workflowTemplateRows      WorkflowTemplate[]
  templateVersionRows       TemplateVersion[]
  taskDefinitionRows        TaskDefinition[]
  placementRows             Placement[]
  placementDateRevisionRows PlacementDateRevision[]
  milestoneRows             Milestone[]
  placementTaskRows         PlacementTask[]
  placementExceptionRows    PlacementException[]
  participantGrantRows      ParticipantGrant[]
  sharedFieldRows           SharedField[]
  readinessDecisionRows     ReadinessDecision[]
  subscriptionRows          Subscription[]
  moduleActivationRows      ModuleActivation[]
  entitlementGrantRows      EntitlementGrant[]
  usageCounterRows          UsageCounter[]
  usageReservationRows      UsageReservation[]
  usageEventRows            UsageEvent[]
  metricDefinitionRows      MetricDefinition[]
  savedViewRows             SavedView[]
  reportSnapshotRows        ReportSnapshot[]
  exportArtifactRows        ExportArtifact[]
  downloadGrantRows         DownloadGrant[]
  importBatchRows           ImportBatch[]
  importErrorRows           ImportError[]
  idempotencyRecordRows     IdempotencyRecord[]
  outboxEventRows           OutboxEvent[]
  inboxEventRows            InboxEvent[]
  backgroundJobRows         BackgroundJob[]
  notificationDeliveryRows  NotificationDelivery[]
  auditEventRows            AuditEvent[]
  placementTransitionRows   PlacementTransition[]
  reportMetricBindingRows   ReportMetricBinding[]
  reportResultRowRows       ReportResultRow[]
  contactMembershipLinkRows ContactMembershipLink[]

  @@map("tenant")
}

model LegalEntity {
  id                         String            @default(uuid()) @db.Uuid
  tenantId                   String            @map("tenant_id") @db.Uuid
  version                    Int               @default(1)
  createdAt                  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt                 DateTime?         @map("archived_at") @db.Timestamptz(6)
  deletedAt                  DateTime?         @map("deleted_at") @db.Timestamptz(6)
  code                       String            @db.VarChar(40)
  name                       String            @db.VarChar(240)
  countryCode                String            @map("country_code") @db.Char(2)
  authorityCode              String            @map("authority_code") @db.VarChar(80)
  timeZone                   String            @map("time_zone") @db.VarChar(80)
  defaultCurrency            String            @map("default_currency") @db.Char(3)
  tenant                     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fromTeam_entity            Team[]            @relation("Team_entity")
  fromRetentionPolicy_entity RetentionPolicy[] @relation("RetentionPolicy_entity")
  fromRoleGrant_entity       RoleGrant[]       @relation("RoleGrant_entity")
  fromClientAccount_entity   ClientAccount[]   @relation("ClientAccount_entity")
  fromPlacement_entity       Placement[]       @relation("Placement_entity")

  @@id([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, createdAt, id])
  @@map("legal_entity")
}

model Team {
  members            TeamMembership[]
  id                 String           @default(uuid()) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  version            Int              @default(1)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt         DateTime?        @map("archived_at") @db.Timestamptz(6)
  deletedAt          DateTime?        @map("deleted_at") @db.Timestamptz(6)
  code               String           @db.VarChar(60)
  name               String           @db.VarChar(160)
  entityId           String           @map("entity_id") @db.Uuid
  parentId           String?          @map("parent_id") @db.Uuid
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  entity             LegalEntity      @relation("Team_entity", fields: [tenantId, entityId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  parent             Team?            @relation("Team_parent", fields: [tenantId, parentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  fromTeam_parent    Team[]           @relation("Team_parent")
  fromRoleGrant_team RoleGrant[]      @relation("RoleGrant_team")
  fromSavedView_team SavedView[]      @relation("SavedView_team")

  @@id([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, createdAt, id])
  @@index([tenantId, entityId])
  @@index([tenantId, parentId])
  @@map("team")
}

model RetentionPolicy {
  id                 String       @default(uuid()) @db.Uuid
  tenantId           String       @map("tenant_id") @db.Uuid
  version            Int          @default(1)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt         DateTime?    @map("archived_at") @db.Timestamptz(6)
  deletedAt          DateTime?    @map("deleted_at") @db.Timestamptz(6)
  recordClass        String       @map("record_class") @db.VarChar(80)
  triggerCode        String       @map("trigger_code") @db.VarChar(40)
  retentionDays      Int          @map("retention_days")
  policyVersion      Int          @map("policy_version")
  validFrom          DateTime     @map("valid_from") @db.Date
  validTo            DateTime?    @map("valid_to") @db.Date
  recordedAt         DateTime     @default(now()) @map("recorded_at") @db.Timestamptz(6)
  authorityReference String       @map("authority_reference") @db.VarChar(500)
  entityId           String?      @map("entity_id") @db.Uuid
  reviewerId         String       @map("reviewer_id") @db.Uuid
  supersededAt       DateTime?    @map("superseded_at") @db.Timestamptz(6)
  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  entity             LegalEntity? @relation("RetentionPolicy_entity", fields: [tenantId, entityId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  reviewer           Membership   @relation("RetentionPolicy_reviewer", fields: [tenantId, reviewerId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, id])
  @@unique([tenantId, recordClass, policyVersion])
  @@index([tenantId, createdAt, id])
  @@index([tenantId, entityId])
  @@index([tenantId, reviewerId])
  @@map("retention_policy")
}

model LegalHold {
  id                  String       @default(uuid()) @db.Uuid
  tenantId            String       @map("tenant_id") @db.Uuid
  version             Int          @default(1)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt          DateTime?    @map("archived_at") @db.Timestamptz(6)
  deletedAt           DateTime?    @map("deleted_at") @db.Timestamptz(6)
  reasonCode          String       @map("reason_code") @db.VarChar(60)
  authorityReference  String       @map("authority_reference") @db.VarChar(500)
  reviewDueAt         DateTime     @map("review_due_at") @db.Timestamptz(6)
  releasedAt          DateTime?    @map("released_at") @db.Timestamptz(6)
  ownerId             String       @map("owner_id") @db.Uuid
  tenant              Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  owner               Membership   @relation("LegalHold_owner", fields: [tenantId, ownerId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  fromHeldRecord_hold HeldRecord[] @relation("HeldRecord_hold")

  @@id([tenantId, id])
  @@index([tenantId, createdAt, id])
  @@index([tenantId, ownerId])
  @@map("legal_hold")
}

model HeldRecord {
  id         String    @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  version    Int       @default(1)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  recordType String    @map("record_type") @db.VarChar(100)
  recordId   String    @map("record_id") @db.Uuid
  holdId     String    @map("hold_id") @db.Uuid
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  hold       LegalHold @relation("HeldRecord_hold", fields: [tenantId, holdId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, id])
  @@unique([tenantId, holdId, recordType, recordId])
  @@index([tenantId, createdAt, id])
  @@index([tenantId, holdId])
  @@map("held_record")
}

model PrivacyRequest {
  id                   String     @default(uuid()) @db.Uuid
  tenantId             String     @map("tenant_id") @db.Uuid
  version              Int        @default(1)
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt           DateTime?  @map("archived_at") @db.Timestamptz(6)
  deletedAt            DateTime?  @map("deleted_at") @db.Timestamptz(6)
  requestType          String     @map("request_type") @db.VarChar(30)
  subjectReferenceHash String     @map("subject_reference_hash") @db.Char(64)
  state                String     @db.VarChar(30)
  verifiedAt           DateTime?  @map("verified_at") @db.Timestamptz(6)
  dueAt                DateTime   @map("due_at") @db.Timestamptz(6)
  completedAt          DateTime?  @map("completed_at") @db.Timestamptz(6)
  ownerId              String     @map("owner_id") @db.Uuid
  tenant               Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  owner                Membership @relation("PrivacyRequest_owner", fields: [tenantId, ownerId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, id])
  @@index([tenantId, createdAt, id])
  @@index([tenantId, ownerId])
  @@map("privacy_request")
}

model DeletionTombstone {
  id             String    @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  recordType     String    @map("record_type") @db.VarChar(100)
  recordId       String    @map("record_id") @db.Uuid
  deletedAtEvent DateTime  @map("deleted_at_event") @db.Timestamptz(6)
  reasonCode     String    @map("reason_code") @db.VarChar(60)
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, id])
  @@unique([tenantId, recordType, recordId])
  @@index([tenantId, createdAt, id])
  @@map("deletion_tombstone")
}

model Principal {
  id                       String       @default(uuid()) @db.Uuid
  tenantId                 String       @map("tenant_id") @db.Uuid
  version                  Int          @default(1)
  createdAt                DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt               DateTime?    @map("archived_at") @db.Timestamptz(6)
  deletedAt                DateTime?    @map("deleted_at") @db.Timestamptz(6)
  issuer                   String       @db.VarChar(240)
  subject                  String       @db.VarChar(240)
  state                    String       @db.VarChar(30)
  tenant                   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fromMembership_principal Membership[] @relation("Membership_principal")

  @@id([tenantId, id])
  @@unique([tenantId, issuer, subject])
  @@index([tenantId, createdAt, id])
  @@map("principal")
}

model Membership {
  teams              TeamMembership[]
  reportRuns         ReportRun[]
  commercialRequests CommercialChangeRequest[]

  isExternal Boolean @default(false) @map("is_external")

  id                                   String                  @default(uuid()) @db.Uuid
  tenantId                             String                  @map("tenant_id") @db.Uuid
  version                              Int                     @default(1)
  createdAt                            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                            DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt                           DateTime?               @map("archived_at") @db.Timestamptz(6)
  deletedAt                            DateTime?               @map("deleted_at") @db.Timestamptz(6)
  status                               String                  @db.VarChar(30)
  membershipRevision                   Int                     @default(1) @map("membership_revision")
  displayName                          String                  @map("display_name") @db.VarChar(200)
  workEmail                            String                  @map("work_email") @db.VarChar(320)
  principalId                          String                  @map("principal_id") @db.Uuid
  tenant                               Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  principal                            Principal               @relation("Membership_principal", fields: [tenantId, principalId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  fromRetentionPolicy_reviewer         RetentionPolicy[]       @relation("RetentionPolicy_reviewer")
  fromLegalHold_owner                  LegalHold[]             @relation("LegalHold_owner")
  fromPrivacyRequest_owner             PrivacyRequest[]        @relation("PrivacyRequest_owner")
  fromRoleGrant_membership             RoleGrant[]             @relation("RoleGrant_membership")
  fromSession_membership               Session[]               @relation("Session_membership")
  fromInvitation_inviter               Invitation[]            @relation("Invitation_inviter")
  fromClientAccount_owner              ClientAccount[]         @relation("ClientAccount_owner")
  fromContact_owner                    Contact[]               @relation("Contact_owner")
  fromCandidate_owner                  Candidate[]             @relation("Candidate_owner")
  fromTemplateVersion_publisher        TemplateVersion[]       @relation("TemplateVersion_publisher")
  fromPlacement_owner                  Placement[]             @relation("Placement_owner")
  fromPlacementDateRevision_actor      PlacementDateRevision[] @relation("PlacementDateRevision_actor")
  fromPlacementTask_owner              PlacementTask[]         @relation("PlacementTask_owner")
  fromPlacementTask_completedBy        PlacementTask[]         @relation("PlacementTask_completedBy")
  fromPlacementException_owner         PlacementException[]    @relation("PlacementException_owner")
  fromParticipantGrant_membership      ParticipantGrant[]      @relation("ParticipantGrant_membership")
  fromParticipantGrant_grantedBy       ParticipantGrant[]      @relation("ParticipantGrant_grantedBy")
  fromReadinessDecision_actor          ReadinessDecision[]     @relation("ReadinessDecision_actor")
  fromEntitlementGrant_approver        EntitlementGrant[]      @relation("EntitlementGrant_approver")
  fromSavedView_owner                  SavedView[]             @relation("SavedView_owner")
  fromReportSnapshot_requester         ReportSnapshot[]        @relation("ReportSnapshot_requester")
  fromExportArtifact_owner             ExportArtifact[]        @relation("ExportArtifact_owner")
  fromDownloadGrant_membership         DownloadGrant[]         @relation("DownloadGrant_membership")
  fromImportBatch_requester            ImportBatch[]           @relation("ImportBatch_requester")
  fromIdempotencyRecord_actor          IdempotencyRecord[]     @relation("IdempotencyRecord_actor")
  fromBackgroundJob_principal          BackgroundJob[]         @relation("BackgroundJob_principal")
  fromNotificationDelivery_recipient   NotificationDelivery[]  @relation("NotificationDelivery_recipient")
  fromAuditEvent_actor                 AuditEvent[]            @relation("AuditEvent_actor")
  fromPlacementTransition_actor        PlacementTransition[]   @relation("PlacementTransition_actor")
  fromContactMembershipLink_membership ContactMembershipLink[] @relation("ContactMembershipLink_membership")
  fromContactMembershipLink_verifiedBy ContactMembershipLink[] @relation("ContactMembershipLink_verifiedBy")

  @@id([tenantId, id])
  @@unique([tenantId, principalId])
  @@index([tenantId, createdAt, id])
  @@index([tenantId, principalId])
  @@map("membership")
}

model Role {
  id                      String           @default(uuid()) @db.Uuid
  tenantId                String           @map("tenant_id") @db.Uuid
  version                 Int              @default(1)
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt              DateTime?        @map("archived_at") @db.Timestamptz(6)
  deletedAt               DateTime?        @map("deleted_at") @db.Timestamptz(6)
  roleKey                 String           @map("role_key") @db.VarChar(80)
  name                    String           @db.VarChar(160)
  bundleVersion           Int              @default(1) @map("bundle_version")
  tenant                  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fromRolePermission_role RolePermission[] @relation("RolePermission_role")
  fromRoleGrant_role      RoleGrant[]      @relation("RoleGrant_role")
  fromInvitation_role     Invitation[]     @relation("Invitation_role")

  @@id([tenantId, id])
  @@unique([tenantId, roleKey])
  @@index([tenantId, createdAt, id])
  @@map("role")
}

model RolePermission {
  id            String    @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  permissionKey String    @map("permission_key") @db.VarChar(120)
  roleId        String    @map("role_id") @db.Uuid
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role          Role      @relation("RolePermission_role", fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, id])
  @@unique([tenantId, roleId, permissionKey])
  @@index([tenantId, createdAt, id])
  @@index([tenantId, roleId])
  @@map("role_permission")
}

model RoleGrant {
  id           String         @default(uuid()) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  version      Int            @default(1)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt   DateTime?      @map("archived_at") @db.Timestamptz(6)
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz(6)
  scopeType    String         @map("scope_type") @db.VarChar(30)
  validFrom    DateTime       @map("valid_from") @db.Timestamptz(6)
  expiresAt    DateTime?      @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime?      @map("revoked_at") @db.Timestamptz(6)
  membershipId String         @map("membership_id") @db.Uuid
  roleId       String         @map("role_id") @db.Uuid
  entityId     String?        @map("entity_id") @db.Uuid
  teamId       String?        @map("team_id") @db.Uuid
  clientId     String?        @map("client_id") @db.Uuid
  placementId  String?        @map("placement_id") @db.Uuid
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  membership   Membership     @relation("RoleGrant_membership", fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  role         Role           @relation("RoleGrant_role", fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  entity       LegalEntity?   @relation("RoleGrant_entity", fields: [tenantId, entityId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  team         Team?          @relation("RoleGrant_team", fields: [tenantId, teamId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  client       ClientAccount? @relation("RoleGrant_client", fields: [tenantId, clientId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  placement    Placement?     @relation("RoleGrant_placement", fields: [tenantId, placementId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, id])
  @@index([tenantId, createdAt, id])
  @@index([tenantId, membershipId])
  @@index([tenantId, roleId])
  @@index([tenantId, entityId])
  @@index([tenantId, teamId])
  @@index([tenantId, clientId])
  @@index([tenantId, placementId])
  @@map("role_grant")
}

model Session {
  id                 String     @default(uuid()) @db.Uuid
  tenantId           String     @map("tenant_id") @db.Uuid
  version            Int        @default(1)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt         DateTime?  @map("archived_at") @db.Timestamptz(6)
  deletedAt          DateTime?  @map("deleted_at") @db.Timestamptz(6)
  tokenHash          String     @map("token_hash") @db.Char(64)
  expiresAt          DateTime   @map("expires_at") @db.Timestamptz(6)
  idleExpiresAt      DateTime   @map("idle_expires_at") @db.Timestamptz(6)
  revokedAt          DateTime?  @map("revoked_at") @db.Timestamptz(6)
  lastMfaAt          DateTime?  @map("last_mfa_at") @db.Timestamptz(6)
  membershipRevision Int        @map("membership_revision")
  membershipId       String     @map("membership_id") @db.Uuid
  tenant             Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  membership         Membership @relation("Session_membership", fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, id])
  @@unique([tenantId, tokenHash])
  @@index([tenantId, createdAt, id])
  @@index([tenantId, membershipId])
  @@map("session")
}

model Invitation {
  deliveryRows InvitationDelivery[]

  recipientCiphertext String    @map("recipient_ciphertext") @db.VarChar(1200)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(6)
  taskIds             Json      @map("task_ids")
  sharedFields        Json      @map("shared_fields")

  id          String     @default(uuid()) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  version     Int        @default(1)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
